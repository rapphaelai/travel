# Copiaza fisierul asta in ".env" (fara ".example") si completeaza valorile.
# ".env" e in .gitignore -- cheile tale nu ajung niciodata in git/GitHub.

# --- ElevenLabs (voce AI pentru videoclipurile UGC) ---
# Cont -> Profile -> API Keys (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# --- Meta Ads (Raphael Travel) ---
# Vezi README.md -> "Conectarea contului Meta Ads" pentru pasii de generare
# a unui access token de sistem (System User) pe termen lung.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
